module OpenUSDInterop {
    header "OpenUSDInterop.h"

    // Base modules - Arch (platform, timing, filesystem, environment)
    header "base/arch.h"

    // Base modules - Tf (tokens, types)
    header "base/tf.h"

    // Base modules - Gf (graphics foundations: vectors, matrices, quaternions)
    header "base/gf.h"

    // Base modules - Vt (value types: arrays, values, dictionaries)
    header "base/vt.h"

    // USD modules - Sdf (scene description foundation: paths, layers, asset paths)
    header "usd/sdf.h"

    // USD modules - Kind (model hierarchy kinds)
    header "usd/kind.h"

    // USD modules - Usd (core USD: stage, prim, attribute, relationship, property)
    header "usd/usd.h"

    // USD modules - UsdGeom (geometry schemas: Xform, Mesh, primitives, camera)
    header "usdGeom/usdGeom.h"

    // USD modules - UsdShade (shading: Material, Shader, NodeGraph, Input, Output, MaterialBindingAPI)
    header "usdShade/usdShade.h"

    // USD modules - UsdLux (lighting: DistantLight, DomeLight, RectLight, SphereLight, CylinderLight, DiskLight)
    header "usdLux/usdLux.h"

    export *
}
