module OpenUSDInterop {
    header "OpenUSDInterop.h"

    // Base modules - Arch (platform, timing, filesystem, environment)
    header "base/arch.h"

    // Base modules - Tf (tokens, types)
    header "base/tf.h"

    // Base modules - Gf (graphics foundations: vectors, matrices, quaternions)
    header "base/gf.h"

    // Base modules - Vt (value types: arrays, values, dictionaries)
    header "base/vt.h"

    // USD modules - Ar (asset resolution: resolver, context, resolved path)
    header "usd/ar.h"

    // USD modules - Sdf (scene description foundation: paths, layers, asset paths)
    header "usd/sdf.h"

    // USD modules - Kind (model hierarchy kinds)
    header "usd/kind.h"

    // USD modules - Usd (core USD: stage, prim, attribute, relationship, property)
    header "usd/usd.h"

    // USD modules - UsdGeom (geometry schemas: Xform, Mesh, primitives, camera)
    header "usdGeom/usdGeom.h"

    // USD modules - UsdShade (shading: Material, Shader, NodeGraph, Input, Output, MaterialBindingAPI)
    header "usdShade/usdShade.h"

    // USD modules - UsdLux (lighting: DistantLight, DomeLight, RectLight, SphereLight, CylinderLight, DiskLight, LightFilter, ShadowAPI)
    header "usdLux/usdLux.h"

    // USD modules - UsdSkel (skeleton: SkelRoot, Skeleton, Animation, BlendShape, BindingAPI)
    header "usdSkel/usdSkel.h"

    // USD modules - UsdVol (volumes: Volume, Field3DAsset, OpenVDBAsset)
    header "usdVol/usdVol.h"

    // USD modules - UsdProc (procedurals: GenerativeProcedural)
    header "usdProc/usdProc.h"

    // USD modules - UsdUtils (utilities: StageCache, FlattenLayerStack, StitchLayers)
    header "usdUtils/usdUtils.h"

    // Imaging modules - Garch (Graphics Architecture: GL context, platform detection)
    header "imaging/garch.h"

    // Imaging modules - Hio (Image loading, OpenEXR, texture formats)
    header "imaging/hio.h"

    // Imaging modules - Hgi (Hydra Graphics Interface: GPU abstraction, buffers, textures, pipelines)
    header "imaging/hgi.h"

    // Imaging modules - HgiMetal (Metal implementation of Hgi)
    header "imaging/hgiMetal.h"

    // Imaging modules - CameraUtil (Camera framing, conformance, screen window)
    header "imaging/cameraUtil.h"

    export *
}
